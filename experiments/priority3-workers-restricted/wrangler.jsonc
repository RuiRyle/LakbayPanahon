{
  "name": "lakbay-local-compatibility-only",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "send_metrics": false,
  "vars": {
    "LOCAL_ONLY": "1",
    "GCLOUD_PROJECT": "demo-lakbaypanahon",
    "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8180",
    "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099"
  },
  "durable_objects": {"bindings": [{"name":"PROBE","class_name":"CoordinatorProbe"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["CoordinatorProbe"]}]
}
