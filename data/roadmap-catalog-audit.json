  "missions": [
    {
      "name": "projects/lakbaypanahon-1797e/databases/(default)/documents/missions/chapter2-mission1",
      "fields": {
        "chapterId": {
          "stringValue": "chapter-2"
        },
        "title": {
          "stringValue": "Roles and Responsibilities in Early Filipino Communities"
        },
        "order": {
          "integerValue": "1"
        },
        "learningObjective": {
          "stringValue": "By the end of this mission, learners will be able to identify the roles and responsibilities of different members of early Filipino communities, explain how leaders and community members contributed to daily life, and recognize the importance of cooperation and shared responsibilities in maintaining community well-being."
        },
        "introduction": {
          "stringValue": "Welcome, young history explorer!\n\nIn early Filipino communities, people worked together to keep their settlements safe, organized, and thriving. Leaders helped guide community decisions, while farmers, fishers, craftspeople, traders, and other members contributed their knowledge and skills.\n\nBut did everyone have the same responsibilities? How did people cooperate, and how did their roles shape everyday life?\n\nIn this mission, you will explore the different responsibilities within early Filipino communities and discover why cooperation was important to their way of life.\n\nYour journey begins now!"
        },
        "xpReward": {
          "integerValue": "45"
        },
        "status": {
          "stringValue": "active"
        },
        "lessonRecap": {
          "stringValue": "Community members had different roles and responsibilities. Leadership, family connections, customs and cooperation could support daily life, while social positions could affect rights and duties."
        },
        "learningObjectives": {
          "arrayValue": {
            "values": [
              {
                "stringValue": "Identify leadership and community responsibilities."
              },
              {
                "stringValue": "Explain how relatives, customs and cooperation supported community life."
              },
              {
                "stringValue": "Recognize that rights, duties and freedom could differ by social position."
              }
            ]
          }
        }
      },
      "createTime": "2026-10-10T13:47:32.729617Z",
      "updateTime": "2026-10-26T14:41:19.621211Z"
    },
    {
      "name": "projects/lakbaypanahon-1797e/databases/(default)/documents/missions/chapter2-mission2",
      "fields": {
        "chapterId": {
          "stringValue": "chapter-2"
        },
        "order": {
          "integerValue": "2"
        },
        "status": {
          "stringValue": "active"
        },
        "title": {
          "stringValue": "Beliefs and Cultural Traditions"
        },
        "xpReward": {
          "integerValue": "45"
        },
        "introduction": {
          "stringValue": "Welcome back, young history explorer! Long ago, Filipino communities had different beliefs, customs, and traditions. Families shared stories, and elders taught children important lessons. Some communities held special ceremonies to show respect for spirits, ancestors, or nature. Not all communities followed the same traditions. In this mission, you will learn about the beliefs, stories, and customs that were important to early Filipinos."
        },
        "learningObjective": {
          "stringValue": "By the end of this mission, learners will be able to describe some beliefs and traditions of early Filipino communities, explain why people held ceremonies and shared stories, and understand that different communities had different customs that were passed down from older to younger generations."
        },
        "lessonRecap": {
          "stringValue": "Beliefs and traditions differed among early Philippine communities. Ritual specialists, ceremonies and oral traditions could support spiritual and cultural life. Artifacts offer clues that require careful interpretation."
        },
        "learningObjectives": {
          "arrayValue": {
            "values": [
              {
                "stringValue": "Describe examples of spiritual roles, beliefs and ceremonies."
              },
              {
                "stringValue": "Explain how oral traditions passed knowledge between generations."
              },
              {
                "stringValue": "Recognize cultural diversity and interpret artifacts with historical context."
              }
            ]
          }
        }
      },
      "createTime": "2026-10-10T18:10:13.693334Z",
      "updateTime": "2026-10-26T14:41:19.621211Z"
    },
    {
      "name": "projects/lakbaypanahon-1797e/databases/(default)/documents/missions/chapter2-mission3",
      "fields": {
        "title": {
          "stringValue": "Islam and Cultural Exchange"
        },
        "description": {
          "stringValue": "Explore how trade, travel, and community relationships helped Islam spread to parts of the Philippines. Learn about the growth of Muslim communities in Mindanao and Sulu and how cultural exchange shaped Philippine history."
        },
        "chapterId": {
          "stringValue": "chapter-2"
        },
        "order": {
          "integerValue": "3"
        },
        "xpReward": {
          "integerValue": "100"
        },
        "status": {
          "stringValue": "active"
        },
        "lessonRecap": {
          "stringValue": "Trade, travel and teaching connected communities and helped Islam spread gradually to some parts of the Philippines. Families, teachers and leaders contributed to Muslim community life, including in Sulu and parts of Mindanao."
        },
        "learningObjectives": {
          "arrayValue": {
            "values": [
              {
                "stringValue": "Explain how contact and teaching contributed to the spread of Islam."
              },
              {
                "stringValue": "Identify kindness, charity and care for others among the teachings discussed."
              },
              {
                "stringValue": "Describe community development and leadership while recognizing diverse Philippine traditions."
              }
            ]
          }
        }
      },
      "createTime": "2026-10-11T16:32:24.418903Z",
      "updateTime": "2026-10-26T14:41:19.621211Z"
    },
