    {
      "name": "projects/lakbaypanahon-1797e/databases/(default)/documents/missions/mission-1",
      "fields": {
        "chapterId": {
          "stringValue": "chapter-1"
        },
        "title": {
          "stringValue": "Life in the Barangay"
        },
        "order": {
          "integerValue": "1"
        },
        "status": {
          "stringValue": "active"
        },
        "storyContent": {
          "stringValue": "Welcome, young traveler! You have arrived in an early Filipino community. In this mission, you will explore how people lived, worked, traded, and organized their community."
        },
        "introduction": {
          "stringValue": "Travel back to the Philippines before Spanish colonization and explore life in an early Filipino barangay.\n\nMeet the people who formed the community, discover how leaders guided their people, and investigate how social roles, customs, and cooperation helped maintain community life.\n\nExplore historical clues, make thoughtful decisions, and use what you discover to complete your Mission Trial."
        },
        "learningObjective": {
          "stringValue": "Explain how early Filipino barangays were organized, including leadership, social roles, customs, and cooperation in community life."
        },
        "xpReward": {
          "integerValue": "45"
        },
        "lessonRecap": {
          "stringValue": "Barangay life involved local leadership, different social roles, customs and cooperation. Communities could organize themselves in different ways."
        },
        "learningObjectives": {
          "arrayValue": {
            "values": [
              {
                "stringValue": "Describe a barangay as an organized community."
              },
              {
                "stringValue": "Explain how leadership, customs and cooperation could support community life."
              },
              {
                "stringValue": "Recognize that social roles and organization varied among communities."
              }
            ]
          }
        }
      },
      "createTime": "2026-10-01T10:28:16.683862Z",
      "updateTime": "2026-10-26T14:41:19.621211Z"
    },
    {
      "name": "projects/lakbaypanahon-1797e/databases/(default)/documents/missions/mission-2",
      "fields": {
        "chapterId": {
          "stringValue": "chapter-1"
        },
        "title": {
          "stringValue": "Trade and Livelihood"
        },
        "order": {
          "integerValue": "2"
        },
        "status": {
          "stringValue": "active"
        },
        "xpReward": {
          "integerValue": "45"
        },
        "introduction": {
          "stringValue": "Travel back to the Philippines before Spanish colonization and discover how early Filipino communities made a living.\nExplore farms, fishing areas, workshops, and trading places. Investigate how people used natural resources, developed useful skills, and exchanged goods to support their families and communities.\nFollow historical clues, make thoughtful decisions, and prepare for your Mission Trial."
        },
        "lessonRecap": {
          "stringValue": "Farming, fishing and craft skills helped communities use local resources for daily needs. Trade connected communities with different products and resources."
        },
        "learningObjectives": {
          "arrayValue": {
            "values": [
              {
                "stringValue": "Connect farming and fishing to local environments and food needs."
              },
              {
                "stringValue": "Explain how craft skills produced useful objects."
              },
              {
                "stringValue": "Describe how exchanging products could meet different community needs."
              }
            ]
          }
        },
        "learningObjective": {
          "stringValue": "Explain how farming, fishing, crafts, natural resources, and trade supported the livelihood and economic activities of early Filipino communities."
        }
      },
      "createTime": "2026-10-01T12:10:11.081481Z",
      "updateTime": "2026-10-26T14:41:19.621211Z"
    }
