      "name": {
        "stringValue": "Manunggul Jar"
      },
      "description": {
        "stringValue": "A collectible inspired by the Manunggul Jar, an ancient burial jar found in Palawan. Its lid shows two figures in a boat, often interpreted as a journey to the afterlife. It helps us learn about burial beliefs and traditions in one ancient Philippine community."
      },
      "icon": {
        "stringValue": "🏺"
      },
      "missionId": {
