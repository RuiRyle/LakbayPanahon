    "fields": {
      "name": {
        "stringValue": "Sheikh Karimul Makhdum Mosque"
      },
      "description": {
        "stringValue": "A collectible inspired by the historic Sheikh Karimul Makhdum Mosque in Simunul, Tawi-Tawi. Traditionally associated with the year 1380, this site reminds us of the early spread of Islam and the development of Muslim communities in the southern Philippines. The present-day mosque is not the original fourteenth-century building."
      },
      "icon": {
        "stringValue": "🕌"
      },
