  {
    "path": "questions/quiz-1-question-5-retry",
    "document": {
      "name": "projects/lakbaypanahon-1797e/databases/(default)/documents/questions/quiz-1-question-5-retry",
      "fields": {
        "quizId": {
          "stringValue": "quiz-1"
        },
        "optionA": {
          "stringValue": "The community ignores the disagreement because customs and leadership are unnecessary."
        },
        "status": {
          "stringValue": "active"
        },
        "difficulty": {
          "stringValue": "medium"
        },
        "order": {
          "integerValue": "105"
        },
        "correctAnswer": {
          "stringValue": "D"
        },
        "topicLabel": {
          "stringValue": "Community Customs"
        },
        "optionC": {
          "stringValue": "The community waits for an outsider to make every decision."
        },
        "optionD": {
          "stringValue": "The community seeks guidance from its leader and considers its customs and shared responsibilities."
        },
        "explanation": {
          "stringValue": "Early Filipino communities had ways of maintaining order. Leaders such as the datu could help address community concerns, while customs and shared responsibilities helped guide community life. Practices could differ among communities."
        },
        "optionB": {
          "stringValue": "Every family must leave the barangay whenever a disagreement occurs."
        },
        "topic": {
          "stringValue": "community-customs"
        },
        "question": {
          "stringValue": "Two families disagree about a shared responsibility. Which response uses the community?s organization to address the concern?"
        },
        "historicalClue": {
          "stringValue": "Customs and community relationships were important parts of early Filipino society. Communities developed their own ways of organizing life and responding to concerns."
        }
      },
      "createTime": "2026-10-26T08:42:33.073625Z",
      "updateTime": "2026-10-26T08:42:33.073625Z"
    }
